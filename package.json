{
	"name": "@zeix/le-truc-compiler",
	"version": "0.1-next.1",
	"description": "The Le Truc component compiler: builds a corpus of .tsx (stable) and .tsrx (experimental) component sources into server render modules, client modules and scoped CSS.",
	"keywords": [
		"Le Truc",
		"Web Components",
		"Custom Elements",
		"Compiler",
		"SSG",
		"SSR"
	],
	"homepage": "https://zeixcom.github.io/le-truc/",
	"bugs": {
		"url": "https://github.com/zeixcom/le-truc-compiler/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zeixcom/le-truc-compiler.git"
	},
	"license": "MIT",
	"author": "Esther Brunner",
	"type": "module",
	"main": "./dist/contract.js",
	"types": "./dist/contract.d.ts",
	"exports": {
		".": {
			"types": "./dist/contract.d.ts",
			"default": "./dist/contract.js"
		},
		"./macros": {
			"types": "./dist/macros.d.ts",
			"default": "./dist/macros.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=18.18"
	},
	"scripts": {
		"build": "bun run scripts/build-compiler.ts",
		"build:corpus": "bun run scripts/build-corpus.ts",
		"build:demo": "bun run scripts/build-demo.ts",
		"check:contract": "bun run scripts/contract-check.ts",
		"check:corpus": "bun run scripts/check-corpus.ts",
		"check:demo": "tsc -p demo/tsconfig.json --noEmit",
		"check:package": "bun run scripts/check-package.ts",
		"check:peer": "bun run scripts/check-runtime-peer.ts",
		"check:queue": "bun run scripts/queue.ts check",
		"i18n:sync": "bun run scripts/i18n-sync.ts",
		"lint": "bunx biome check --write ./src ./tests ./scripts ./server",
		"queue:build": "bun run scripts/queue.ts build",
		"queue:serve": "bun run server/queue-board.ts",
		"test": "bun test tests",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@messageformat/date-skeleton": "^1.1.0",
		"@messageformat/number-skeleton": "^1.2.0",
		"@messageformat/parser": "^5.1.1",
		"@tsrx/core": "0.2.3",
		"@typescript-eslint/typescript-estree": "8.71.0",
		"css-select": "^7.0.0",
		"css-tree": "^3.2.1",
		"css-what": "^8.0.0",
		"eslint-visitor-keys": "5.0.1",
		"lightningcss-wasm": "1.33.0",
		"parse5": "^7.0.0"
	},
	"peerDependencies": {
		"@zeix/le-truc": "^3.0.0-next.1",
		"jsdom": "^30.0.0",
		"typescript": ">=5.8.0 <6.1.0"
	},
	"peerDependenciesMeta": {
		"jsdom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@messageformat/core": "^3.4.0",
		"@messageformat/icu-messageformat-1": "^0.12.0",
		"@playwright/test": "^1.62.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.2.0",
		"@zeix/cem-plugin-le-truc": "^0.3.3",
		"@zeix/le-truc": "file:../le-truc",
		"dompurify": "^3.4.14",
		"jsdom": "^30.0.1",
		"messageformat": "^4",
		"typescript": "^6.0.3"
	},
	"customElements": "custom-elements.json"
}
